{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "amphp/http-client": "^5.3.6",
        "doctrine/dbal": "^4.4.4",
        "doctrine/doctrine-bundle": "^2.19.0",
        "doctrine/doctrine-migrations-bundle": "^3.7.0",
        "doctrine/orm": "^3.6.8",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.3",
        "symfony/asset": "8.1.4.*",
        "symfony/asset-mapper": "8.1.4.*",
        "symfony/console": "8.1.4.*",
        "symfony/doctrine-messenger": "8.1.4.*",
        "symfony/dotenv": "8.1.4.*",
        "symfony/expression-language": "8.1.4.*",
        "symfony/flex": "^2.11.0",
        "symfony/form": "8.1.4.*",
        "symfony/framework-bundle": "8.1.4.*",
        "symfony/http-client": "8.1.4.*",
        "symfony/intl": "8.1.4.*",
        "symfony/mailer": "8.1.4.*",
        "symfony/mime": "8.1.4.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/notifier": "8.1.4.*",
        "symfony/process": "8.1.4.*",
        "symfony/property-access": "8.1.4.*",
        "symfony/property-info": "8.1.4.*",
        "symfony/runtime": "8.1.4.*",
        "symfony/security-bundle": "8.1.4.*",
        "symfony/serializer": "8.1.4.*",
        "symfony/stimulus-bundle": "^2.36",
        "symfony/string": "8.1.4.*",
        "symfony/translation": "8.1.4.*",
        "symfony/twig-bundle": "8.1.4.*",
        "symfony/uid": "8.1.4.*",
        "symfony/ux-turbo": "^2.36",
        "symfony/validator": "8.1.4.*",
        "symfony/web-link": "8.1.4.*",
        "symfony/yaml": "8.1.4.*",
        "symfonycasts/verify-email-bundle": "^1.18.0",
        "twig/extra-bundle": "^2.12|^3.24.0",
        "twig/twig": "^2.12|^3.28.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.4.*"
        }
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "phpunit/phpunit": "^12.5.33",
        "symfony/browser-kit": "8.1.4.*",
        "symfony/css-selector": "8.1.4.*",
        "symfony/debug-bundle": "8.1.4.*",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/stopwatch": "8.1.4.*",
        "symfony/web-profiler-bundle": "8.1.4.*"
    }
}
